@@ -0,0 +1,58 @@
+name: Native SimpMusic integration
+on:
+  push:
+    branches: ['integration/simpmusic']
+  pull_request:
+    paths:
+      - 'app/**'
+      - 'simpmusic-integration/**'
+      - 'tests/simpmusic/**'
+      - '.github/workflows/simpmusic-integration.yml'
+  workflow_dispatch:
+permissions:
+  contents: write
+concurrency:
+  group: simpmusic-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  android:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+      - name: Materialise reviewed source change set
+        if: github.event_name == 'push' && github.ref == 'refs/heads/integration/simpmusic'
+        run: |
+          if [ -f simpmusic-integration.patch ]; then
+            git apply --check --exclude=.github/workflows/simpmusic-integration.yml simpmusic-integration.patch
+            git apply --exclude=.github/workflows/simpmusic-integration.yml simpmusic-integration.patch
+            git config user.name 'github-actions[bot]'
+            git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+            git add app simpmusic-integration tests/simpmusic .gitignore .gitattributes
+            git rm simpmusic-integration.patch
+            git commit -m 'Integrate pinned native SimpMusic sources with Glyphix'
+            git push origin HEAD:integration/simpmusic
+          fi
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: android-actions/setup-android@v3
+      - name: Prepare pinned sources and verify patches
+        run: python3 simpmusic-integration/prepare.py
+      - name: Test PCM conversion
+        run: bash tests/simpmusic/run.sh
+      - name: Install Android platform
+        run: sdkmanager 'platforms;android-37' 'build-tools;37.0.0'
+      - name: Create development signing key
+        run: |
+          mkdir -p keystore
+          keytool -genkeypair -keystore keystore/debug.keystore -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname 'CN=Glyphix Development,O=Glyphix,C=IE'
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Compile integrated APK and run lint
+        run: bash .simpmusic-build/gradlew -p .simpmusic-build :glyphix:assembleDebug :glyphix:lintDebug --no-configuration-cache
+      - uses: actions/upload-artifact@v4
+        with:
+          name: glyphix-simpmusic-debug
+          path: app/build/outputs/apk/debug/*.apk
+          if-no-files-found: error
